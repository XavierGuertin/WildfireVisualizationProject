{
  "name": "frontend",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "npx next build"
      },
      "configurations": {
        "coverage": {
          "command": "nyc --reporter=html --reporter=text npx nx run frontend:build"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "npx next dev -p 3000"
      },
      "configurations": {
        "build": {
          "command": "npx nx run frontend:build && npx nx run frontend:serve"
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "npm run lint"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "npx jest --config ./jest.config.ts"
      }
    }
  },
  "tags": []
}
